{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elle-jew-loja",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ASAAS_ENVIRONMENT": "sandbox",
    "SHIPPING_TEST_PRICE_CENTS": "100"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elle-jew-db",
      "database_id": "e3592ccb-6d50-4ee6-ac1f-c2f899056aa4",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "elle-jew-media"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "observability": {
    "enabled": true
  }

  // Depois de testar o endereço workers.dev, o domínio pode ser ligado pelo
  // painel da Cloudflare em Workers & Pages > Settings > Domains & Routes.
}
